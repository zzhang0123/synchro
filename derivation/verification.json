	"expressions":{
		"arrivalTime":"t - bl*t*Cos[theta] + (bp*Sin[phase0 + omegaB*t]*Sin[theta])\/omegaB",
		"lineFrequency":"(m*omegaB)\/(1 - bl*Cos[theta])",
		"projectedVelocity":"{-(bp*Cos[phase0 + omegaB*t]*Cos[theta]) - bl*Sin[theta], -(bp*Sin[phase0 + omegaB*t])}",
		"electricField":"{(bp*charge*omegaB*(bl - Cos[theta])*Sin[phase0 + omegaB*t])\/(light*radius*(1 - bl*Cos[theta] + bp*Cos[phase0 + omegaB*t]*Sin[theta])^3), (bp*charge*omegaB*(Cos[phase0 + omegaB*t]*(-1 + bl*Cos[theta]) - bp*Sin[theta]))\/(light*radius*(-1 + bl*Cos[theta] - bp*Cos[phase0 + omegaB*t]*Sin[theta])^3)}",
		"harmonicAmplitudes":"{(-1)^m*BesselJ[m, (bp*m*Sin[theta])\/(1 - bl*Cos[theta])]*(-bl + Cos[theta])*Csc[theta], (I\/2)*(-1)^m*bp*(BesselJ[-1 + m, (bp*m*Sin[theta])\/(1 - bl*Cos[theta])] - BesselJ[1 + m, (bp*m*Sin[theta])\/(1 - bl*Cos[theta])])}",
		"sourceTimePowerPrefactor":"-1\/2*(charge^2*m^2*omegaB^2)\/(light*Pi*(-1 + bl*Cos[theta])^3)",
		"naturalStokes":"{aa^2 + bb^2, (aa - bb)*(aa + bb), 0, 2*aa*bb}",
		"skyStokes":"{aa^2 + bb^2, (aa - bb)*(aa + bb)*Cos[2*phi], (aa - bb)*(aa + bb)*Sin[2*phi], 2*aa*bb}",
		"totalPower":"(2*acc^2*charge^2)\/(3*light*(-1 + speed^2)^2)",
		"coolingOrbitRatio":"(3*light^4*mass^2)\/(4*bp^2*charge^3*field*lorentz^2*Pi)"
	},
